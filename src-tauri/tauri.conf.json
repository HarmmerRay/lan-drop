{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanDrop",
  "version": "0.1.3",
  "identifier": "com.landrop.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LanDrop",
        "width": 900,
        "height": 620,
        "minWidth": 700,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://sub.hugme.space/landrop/update.json",
        "http://199.102.216.216/landrop/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCODk3QzU5NjkxQjRCODUKUldTRlN4dHBXWHlKUzllUjJNNGJMd2xPNGd6RW5ROUkveDZtb205V0RKWE44cmV6N2NSK3BEVmwK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}